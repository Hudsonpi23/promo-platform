// Prisma Schema - Promo Platform
// Sistema de Promoções para Afiliados

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  OPERATOR
}

enum OfferStatus {
  ACTIVE
  ARCHIVED
}

enum DraftStatus {
  PENDING
  APPROVED
  DISPATCHED
  ERROR
  REJECTED
  PENDING_X_QUOTA // Aguardando quota do X
}

enum BatchStatus {
  PENDING
  LOCKED
  CLOSED
}

enum DeliveryStatus {
  PENDING
  SENT
  ERROR
}

enum Channel {
  TELEGRAM
  WHATSAPP
  FACEBOOK
  TWITTER
  INSTAGRAM
  SITE
}

// 🔥 Status de publicação por canal (SISTEMA DE FILAS)
enum ChannelPostStatus {
  PENDING // Aprovado, mas ainda não entrou na fila
  QUEUED // Está na fila do canal (automático)
  POSTED // Já foi publicado (automático)
  ERROR // Erro na publicação
  READY_MANUAL // Pronto para copy/paste (canais manuais)
  DONE_MANUAL // Operador marcou como postado
}

// 🔥 Modo do canal: automático ou manual (copy/paste)
enum ChannelMode {
  AUTO // Publicação automática via API
  MANUAL // Operador faz copy/paste
}

// Estilo de humor da copy
enum HumorStyle {
  URUBU // Estilo "Urubu das Promoções" - informal, meme
  NEUTRO // Tom neutro, profissional
  FLASH // Urgência extrema
  ENGRACADO // Piadas e memes pesados
}

// 🔥 NOVO: Tipo de promoção
enum PromoType {
  RELAMPAGO // Urgência extrema, Thor, raio
  OFERTA_DO_DIA // Destaque sem desespero
  NORMAL // Texto limpo
  CUPOM // Explicar cupom rapidamente
}

// 🔥 NOVO: Modo de geração de link de afiliado
enum AffiliateLinkMode {
  DIRECT_PASTE // Link colado manualmente (Mercado Livre)
  TEMPLATE_APPEND // Adiciona parâmetros ao link
  REDIRECTOR // Usa /go/:offerId?src=:channel
}

// 🔥 NOVO: Nível de automação do canal
enum AutomationLevel {
  TOTAL // Totalmente automático (Telegram, Site, X)
  MANUAL_APPROVAL // Requer aprovação (WhatsApp)
  HUMAN_ONLY // Operador humano (Facebook, Instagram)
}

enum Urgency {
  HOJE
  ULTIMAS_UNIDADES
  LIMITADO
  NORMAL
}

// 🤖 Status de curadoria da oferta (v2.0 IA)
enum CurationStatus {
  DRAFT // Rascunho, aguardando imagem/dados
  PENDING_REVIEW // Aguardando aprovação do operador
  APPROVED // Aprovada pelo operador, pronta para IA
  AI_PROCESSING // IA está processando
  AI_READY // IA finalizou, jobs criados
  AI_BLOCKED // IA bloqueou (risco alto)
}

// 🤖 Status do PostJob (v2.0 IA)
enum PostJobStatus {
  PENDING // Criado pela IA, aguardando fila
  QUEUED // Na fila do scheduler
  POSTED // Publicado com sucesso
  ERROR // Erro na publicação
  CANCELLED // Cancelado
}

// 🤖 Nível de risco da oferta (avaliado pela IA Curadora)
enum RiskLevel {
  LOW // Baixo risco
  MEDIUM // Risco médio
  HIGH // Alto risco - requer atenção
  BLOCKED // Bloqueado pela IA
}

enum Priority {
  HIGH
  NORMAL
  LOW
}

// Source de onde veio a oferta
enum OfferSource {
  MANUAL // Cadastro manual
  MERCADO_LIVRE // API Mercado Livre
  AWIN // Rede Awin (afiliados)
  AMAZON // Amazon (futuro)
  MAGALU // Magazine Luiza (futuro)
  LOMADEE // Lomadee (futuro)
}

// ==================== AUTH ====================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(OPERATOR)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens        RefreshToken[]
  approvedDrafts       PostDraft[]           @relation("ApprovedBy")
  mercadoLivreAccounts MercadoLivreAccount[]
  affiliateAccounts    AffiliateAccount[]    @relation("AffiliateOwner")
  customPhrases        CustomPhrase[]        @relation("CustomPhraseCreator")

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ==================== CONFIG ====================

model Config {
  id               String   @id @default("singleton")
  siteName         String   @default("Manu das Promoções")
  siteBaseUrl      String   @default("https://manupromocoes.com.br")
  defaultUtmSource String   @default("manupromocoes")
  defaultUtmMedium String   @default("site")
  telegramChannel  String? // @manupromocao
  whatsappNumber   String?
  twitterHandle    String? // @manupromocao
  facebookPage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BatchSchedule {
  id        String   @id @default(cuid())
  time      String // "08:00", "11:00", etc
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([time])
  @@index([order])
}

// 🔥 CONFIGURAÇÃO DE REGRAS POR CANAL
model ChannelConfig {
  id      String  @id @default(cuid())
  channel Channel @unique

  // === AUTOMAÇÃO ===
  automationLevel AutomationLevel @default(TOTAL) // TOTAL, MANUAL_APPROVAL, HUMAN_ONLY

  // === INTERVALOS ===
  intervalMinutes   Int @default(15) // Intervalo mínimo entre posts
  burstCooldownSecs Int @default(60) // Cooldown mínimo em burst (segundos)

  // === LIMITES ===
  dailyLimit Int @default(0) // 0 = sem limite

  // === HORÁRIO ===
  activeHours String? @default("08:00-22:00")

  // === BURST MODE (Telegram/Site) ===
  // Ex: [{"hour": 8, "posts": 10}, {"hour": 12, "posts": 15}]
  burstSchedule Json?

  // === ANTI-REPETIÇÃO ===
  repostCooldownHours Int @default(6) // Horas antes de permitir repost

  // === STATUS ===
  isEnabled        Boolean   @default(true)
  lastSchedulerRun DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== PROVIDER CONFIG ====================

model ProviderConfig {
  id      String      @id @default(cuid())
  source  OfferSource @unique
  enabled Boolean     @default(true)

  // Configurações de busca
  keywords   String[] // Palavras-chave para busca
  categories String[] // IDs ou slugs de categorias

  // Filtros
  minDiscount     Int      @default(20) // Desconto mínimo %
  minPrice        Decimal  @default(50) @db.Decimal(10, 2)
  maxPrice        Decimal? @db.Decimal(10, 2)
  conditionFilter String[] @default(["new"]) // "new", "used"

  // Limites
  maxItemsPerRun Int @default(50)

  // X (Twitter) específico
  enableX     Boolean @default(true)
  xDailyLimit Int     @default(30) // Máximo de posts X por dia
  xMinScore   Int     @default(60) // Score mínimo para sugerir X

  // Schedule
  scheduleTimes String[]  @default(["08:00", "11:00", "14:00", "18:00", "22:00"])
  lastRunAt     DateTime?

  // Credenciais (criptografadas ou via env)
  apiKey      String?
  apiSecret   String?
  accessToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== ENTIDADES BASE ====================

model Niche {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers         Offer[]
  publishedPosts PublishedPost[]

  @@index([slug])
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers         Offer[]
  publishedPosts PublishedPost[]

  @@index([slug])
}

// ==================== OFERTAS ====================

model Offer {
  id            String   @id @default(cuid())
  title         String
  description   String?
  originalPrice Decimal? @db.Decimal(10, 2) // 🔥 OPCIONAL para produtos sem desconto
  finalPrice    Decimal  @db.Decimal(10, 2)
  discountPct   Int
  affiliateUrl  String
  imageUrl      String?

  // 🤖 v2.0 IA: IMAGENS (Cloudinary)
  mainImage String? // Imagem principal OBRIGATÓRIA
  images    String[] // Galeria de imagens (URLs Cloudinary)

  nicheId String
  niche   Niche  @relation(fields: [nicheId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  urgency   Urgency     @default(NORMAL)
  status    OfferStatus @default(ACTIVE)
  expiresAt DateTime?

  // 🔥 Tipo de promoção (afeta copy da IA)
  promoType PromoType @default(NORMAL)

  // 🤖 v2.0 IA: STATUS DE CURADORIA
  curationStatus CurationStatus @default(DRAFT)

  // 🤖 v2.0 IA: AVALIAÇÃO DA CURADORA
  aiPriorityScore       Int? // Score 0-100 (calculado pela IA)
  aiRiskLevel           RiskLevel? // Nível de risco
  aiRecommendedNetworks String[] // Redes recomendadas pela IA
  aiBlockReason         String? // Motivo do bloqueio (se houver)
  aiProcessedAt         DateTime? // Quando a IA processou

  // 🔥 Central de Afiliados
  canonicalUrl            String? // URL limpa do produto (para dedupe) - OBRIGATÓRIO
  ownerAffiliateAccountId String? // Dono do tracking
  ownerAffiliateAccount   AffiliateAccount? @relation("OfferAffiliateOwner", fields: [ownerAffiliateAccountId], references: [id])

  affiliateProgramId String? // Programa de afiliados (marketplace)
  affiliateProgram   AffiliateProgram? @relation("OfferAffiliateProgram", fields: [affiliateProgramId], references: [id])

  // 🔥 Cupom (quando promoType = CUPOM)
  couponCode String? // Ex: "PROMO10"

  // === CAMPOS PARA SOURCES EXTERNOS (ex: Mercado Livre) ===
  source            OfferSource @default(MANUAL)
  externalId        String? // ID único da oferta no source (ex: MLB123456)
  productUrl        String? // URL original do produto (não afiliado)
  sellerId          String? // ID do vendedor
  sellerName        String? // Nome do vendedor
  sellerReputation  String? // Reputação do vendedor (ex: "5_green", "platinum")
  availableQuantity Int? // Estoque disponível
  condition         String? // "new", "used", etc
  categoryId        String? // ID da categoria no source
  categoryPath      String? // Caminho completo da categoria

  // Hash para deduplicação (canonicalUrl + 72h)
  dedupeHash String?

  // === CAMPOS DE QUALIDADE E VALIDAÇÃO ===
  rawPayload  Json? // Payload original da fonte (para debug)
  errorReason String? // Motivo de rejeição/erro
  currency    String  @default("BRL")
  country     String  @default("BR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts            PostDraft[]
  publishedPosts    PublishedPost[]
  clicks            Click[]
  postJobs          PostJob[] // 🤖 v2.0 IA: Jobs gerados pela IA
  offerPublications OfferPublication[]

  // Índice único por source + externalId
  @@unique([source, externalId])
  @@index([nicheId])
  @@index([storeId])
  @@index([status])
  @@index([source])
  @@index([dedupeHash])
  @@index([createdAt])
  @@index([curationStatus])
}

// ==================== 🤖 v2.0 IA: POST JOB ====================
// PostJob = Um job de publicação por rede, gerado pela IA
// A IA gera POST_JOB. O SCHEDULER apenas executa POST_JOB.

model PostJob {
  id String @id @default(cuid())

  // Relacionamento com Offer
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  // 🎯 Rede de destino
  network Channel

  // 📝 Conteúdo gerado pela IA
  textFinal String  @db.Text // Copy final gerada pelo agente
  imageUsed String? // URL da imagem usada

  // 🤖 Agente responsável
  agentName  String // "CURADORA", "ANA", "GABRIEL", "THEO", "LAURA"
  agentStyle String? // Estilo usado (ex: "urgente", "conversacional")

  // 📊 Status do job
  status PostJobStatus @default(PENDING)

  // ⏰ Agendamento
  scheduledAt DateTime? // Quando deve ser publicado
  postedAt    DateTime? // Quando foi publicado

  // 🔗 Resultado
  externalId String? // ID externo (tweet_id, post_id, etc)
  postUrl    String? // URL do post publicado

  // ❌ Erro (se houver)
  errorReason String? @db.Text
  retries     Int     @default(0)

  // 📊 Metadados da IA
  aiMetadata Json? // Dados extras da geração (tokens, etc)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offerId, network]) // Uma oferta = um job por rede
  @@index([network, status])
  @@index([scheduledAt])
  @@index([status])
}

// ==================== SISTEMA DE CARGAS ====================

model Batch {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  scheduledTime String // "08:00", "11:00", "14:00", "18:00", "22:00"
  status        BatchStatus @default(PENDING)

  // Contadores desnormalizados
  pendingCount    Int @default(0)
  approvedCount   Int @default(0)
  dispatchedCount Int @default(0)
  errorCount      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drafts PostDraft[]

  @@unique([date, scheduledTime])
  @@index([date])
  @@index([status])
}

// ==================== POSTS ====================

model PostDraft {
  id String @id @default(cuid())

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  // Copy genérica (fallback)
  copyText String @db.Text

  // === COPY POR CANAL (humana, sem "robô vibes") ===
  copyTextTelegram String? @db.Text // 2-3 linhas, link no final
  copyTextSite     String? @db.Text // Similar ao Telegram
  copyTextX        String? @db.Text // Curto ~240 chars, imagem obrigatória, link no final

  channels Channel[]
  priority Priority  @default(NORMAL)

  status     DraftStatus @default(PENDING)
  approvedAt DateTime?

  approvedById String?
  approvedBy   User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  // === SCORE E VALIDAÇÃO ===
  score    Int     @default(0) // Score 0-100 baseado em regras
  aiScore  Int? // Score de confiança da IA (legado)
  errorMsg String? @db.Text

  // === IMAGEM E REQUISITOS ===
  imageUrl          String? // URL da imagem para X
  requiresImage     Boolean @default(false)
  requiresHumanForX Boolean @default(true) // X sempre exige aprovação humana

  // Variantes de copy por canal (JSON - legado, manter compatibilidade)
  copyChannelVariants Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries        PostDelivery[]
  promotionChannels PromotionChannel[] // 🔥 NOVO: Estados por canal

  @@index([batchId])
  @@index([offerId])
  @@index([status])
  @@index([score])
  @@index([createdAt])
}

model PostDelivery {
  id String @id @default(cuid())

  draftId String
  draft   PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  channel      Channel
  status       DeliveryStatus @default(PENDING)
  sentAt       DateTime?
  externalId   String?
  errorMessage String?        @db.Text
  retries      Int            @default(0)

  // Copy gerado pelo CopyEngine para este canal
  payload Json? // { text, headline?, subcopy?, link }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([draftId, channel])
  @@index([status])
  @@index([channel])
}

// ==================== CANAL DE PROMOÇÃO (SISTEMA DE FILAS) ====================
// PromotionChannel - Estados independentes de publicação por canal
// Cada canal tem sua própria fila e ritmo de publicação
// Front-end registra INTENÇÃO → Backend decide QUANDO postar

model PromotionChannel {
  id String @id @default(cuid())

  // Relacionamento com PostDraft (promoção)
  draftId String
  draft   PostDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  // Canal
  channel Channel

  // 🔥 Modo do canal: AUTO ou MANUAL (copy/paste)
  channelMode ChannelMode @default(AUTO)

  // Copy específica para este canal
  copyText String? @db.Text

  // Copy editada pelo operador (modo manual)
  editedCopyText String? @db.Text

  // Estilo de humor da copy
  humorStyle HumorStyle @default(URUBU)

  // 🔥 Status do canal (SISTEMA DE FILAS)
  status ChannelPostStatus @default(PENDING)

  // 🔥 Timestamps da fila
  queuedAt DateTime? // Quando entrou na fila
  postedAt DateTime? // Quando foi publicado

  // 🔥 Modo Manual: timestamps de conclusão
  manualDoneAt   DateTime?
  manualDoneById String?

  // Erro (se houver)
  errorReason String? @db.Text

  // ID externo da publicação (ex: tweet_id, message_id)
  externalId String?

  // 🔥 Links resolvidos
  finalUrl String? // Link monetizado final
  goUrl    String? // Link interno /go/:id?src=channel

  // 🔥 Anti-repetição: hash = offerId + channel + humorStyle
  uniqueHash String?

  // 🔥 Aprovação manual (WhatsApp)
  requiresApproval Boolean   @default(false)
  approvedAt       DateTime?
  approvedById     String?

  // Metadados adicionais
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([draftId, channel])
  // 🔥 Índice otimizado para o scheduler de filas
  @@index([channel, status])
  @@index([channelMode, status])
  @@index([queuedAt])
  @@index([postedAt])
}

// ==================== PUBLICAÇÕES (SITE) ====================

model PublishedPost {
  id String @id @default(cuid())

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  slug   String @unique
  goCode String @unique // Código curto para /go/:code

  // Snapshot dos dados
  title         String
  excerpt       String?  @db.Text
  copyText      String   @db.Text
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal? @db.Decimal(10, 2)
  discountPct   Int
  affiliateUrl  String
  imageUrl      String?
  urgency       Urgency  @default(NORMAL)

  nicheId String
  niche   Niche  @relation(fields: [nicheId], references: [id])

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  isActive    Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clicks Click[]

  @@index([slug])
  @@index([goCode])
  @@index([nicheId])
  @@index([storeId])
  @@index([isActive])
  @@index([publishedAt])
}

// ==================== TRACKING ====================

model Click {
  id String @id @default(cuid())

  goCode String

  publishedPostId String?
  publishedPost   PublishedPost? @relation(fields: [publishedPostId], references: [id])

  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id])

  channel     Channel?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  userAgent   String?  @db.Text
  ipHash      String?
  referer     String?

  createdAt DateTime @default(now())

  @@index([goCode])
  @@index([publishedPostId])
  @@index([offerId])
  @@index([channel])
  @@index([createdAt])
}

// ==================== IMPORTAÇÃO ====================

model ImportJob {
  id        String   @id @default(cuid())
  type      String // OFFERS_JSON, OFFERS_CSV
  status    String   @default("PENDING") // PENDING, RUNNING, DONE, ERROR
  filename  String?
  totalRows Int?
  processed Int      @default(0)
  errors    Int      @default(0)
  errorLog  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ==================== LOGS ====================

model ErrorLog {
  id String @id @default(cuid())

  draftId    String?
  deliveryId String?

  errorType String
  message   String  @db.Text
  details   Json?
  stack     String? @db.Text

  isResolved Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())

  @@index([isResolved])
  @@index([errorType])
  @@index([createdAt])
}

// ==================== MERCADO LIVRE OAUTH (LEGADO - A REMOVER) ====================

model MercadoLivreAccount {
  id String @id @default(cuid())

  // Usuário do sistema que conectou a conta
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Dados do usuário no Mercado Livre
  mlUserId   String  @unique // ID do usuário no ML
  mlNickname String? // Apelido/nome no ML
  mlEmail    String? // Email no ML

  // Tokens OAuth (dinâmicos, gerenciados pelo sistema)
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  tokenType    String   @default("Bearer")
  expiresAt    DateTime // Quando o access_token expira
  scope        String? // Escopos autorizados

  // Status
  isActive      Boolean   @default(true)
  lastUsedAt    DateTime?
  lastRefreshAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mlUserId])
  @@index([userId])
  @@index([isActive])
}

// ==================== 🔥 CENTRAL DE AFILIADOS ====================
// AffiliateAccount = dono do tracking (Hudson, Sócio, Parceiro)
// AffiliateProgram = loja/rede (Mercado Livre, Shopee, Casas Bahia, etc)
// AffiliateCredential = vínculo dono + loja

model AffiliateAccount {
  id   String @id @default(cuid())
  name String // "Hudson", "Parceiro X"
  slug String @unique // "hudson", "parceiro-x"

  // Usuário do sistema (opcional)
  userId String?
  user   User?   @relation("AffiliateOwner", fields: [userId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials AffiliateCredential[]
  offers      Offer[]               @relation("OfferAffiliateOwner")

  @@index([slug])
  @@index([userId])
}

model AffiliateProgram {
  id   String @id @default(cuid())
  name String // "Mercado Livre", "Amazon", "Shopee"
  slug String @unique // "mercado-livre", "amazon"

  // Modo de link
  linkMode AffiliateLinkMode @default(REDIRECTOR)

  // Template de URL (para TEMPLATE_APPEND)
  // Ex: "https://www.amazon.com.br/dp/{productId}?tag={affiliateTag}"
  urlTemplate String?

  // Domínios permitidos (para validação)
  allowedDomains String[] // ["mercadolivre.com.br", "produto.mercadolivre.com.br"]

  // Configurações
  isActive Boolean @default(true)
  logoUrl  String?
  color    String? // Cor da marca

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials AffiliateCredential[]
  offers      Offer[]               @relation("OfferAffiliateProgram")

  @@index([slug])
}

model AffiliateCredential {
  id String @id @default(cuid())

  // Relacionamentos
  accountId String
  account   AffiliateAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  programId String
  program   AffiliateProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  // Credenciais (variam por programa)
  affiliateTag String? // Tag de afiliado (Amazon: "meutag-20")
  affiliateId  String? // ID no programa
  apiKey       String? // Se tiver API
  apiSecret    String? // Se tiver API

  // Metadados
  metadata Json?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, programId])
  @@index([accountId])
  @@index([programId])
}

// ==================== 🔥 ANTI-REPETIÇÃO ====================

model PostHistory {
  id String @id @default(cuid())

  // Hash único: offerId + channel + humorStyle
  uniqueHash String @unique

  offerId    String
  channel    Channel
  humorStyle HumorStyle

  // Dados do post
  copyText   String  @db.Text
  externalId String? // ID no canal (message_id, tweet_id)

  postedAt DateTime @default(now())

  @@index([offerId])
  @@index([channel])
  @@index([postedAt])
}

// ==================== PUBLICAÇÕES POR CANAL ====================

// Registra cada vez que uma oferta é publicada em qualquer canal (manual ou automático)
model OfferPublication {
  id      String @id @default(cuid())
  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  channel   String // "SITE", "TWITTER", "TELEGRAM", "FACEBOOK", "INSTAGRAM", "WHATSAPP"
  externalId String? // ID externo (tweetId, messageId, postId)

  publishedAt DateTime @default(now())

  @@index([offerId])
  @@index([channel])
  @@index([publishedAt])
}

// ==================== FRASES PERSONALIZADAS ====================

// Frases personalizadas criadas pelos usuários/operadores
// Quando um usuário digita uma frase manualmente, ela é salva aqui para reutilização
model CustomPhrase {
  id String @id @default(cuid())

  // A frase em si
  phrase String @db.Text

  // Produto/categoria associada (para reutilização)
  productKeyword String? // Ex: "tv", "perfume", "celular"
  category       String? // Ex: "eletronicos", "perfumes", "moda"

  // Canal específico (opcional - se null, pode ser usado em qualquer canal)
  channel Channel?

  // Quem criou
  createdById String
  createdBy   User   @relation("CustomPhraseCreator", fields: [createdById], references: [id])

  // Metadados
  usageCount Int     @default(0) // Quantas vezes foi usada
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productKeyword])
  @@index([category])
  @@index([channel])
  @@index([isActive])
  @@index([createdById])
}
